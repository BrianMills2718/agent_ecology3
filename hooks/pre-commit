#!/bin/bash
# Pre-commit hook (portable meta-process template)
# Each check only runs if its script is installed.
# Install via: meta-process/install.sh

set -e

echo "Running pre-commit checks..."

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# --- Canonical-checkout guard -------------------------------------------------
# Implementation belongs in a claimed worktree at <repo>/worktrees/<branch>/,
# never the canonical checkout. Inserted by
# project-meta/scripts/rollout_canonical_checkout_guard.py on 2026-08-21, after
# two sessions working one canonical checkout lost a finished, verified edit and
# twice came within one command of committing another agent's unfinished work.
#
# The pre-write claim gate cannot cover this: it is wired to PreToolUse on
# Edit|Write, and bypass-permissions mode instructs agents to change files with
# sed and heredocs instead, so shell writes never reach it. A commit-time check
# sees every write regardless of how it was made.
#
# ALLOW_CANONICAL_CHECKOUT_COMMIT=1 skips only this check, so the rest of the
# suite still runs -- unlike --no-verify, which skips everything.
#
# Both rev-parse calls need --path-format=absolute. From a subdirectory, plain
# --git-common-dir returns a relative path while --git-dir returns absolute, so
# an unnormalized compare is always unequal and the guard silently never fires.
if [[ "${ALLOW_CANONICAL_CHECKOUT_COMMIT:-0}" != "1" ]]; then
    GIT_COMMON_DIR_ABS=$(git rev-parse --path-format=absolute --git-common-dir)
    GIT_DIR_ABS=$(git rev-parse --path-format=absolute --git-dir)
    if [[ "$GIT_COMMON_DIR_ABS" == "$GIT_DIR_ABS" ]]; then
        echo ""
        echo "ERROR: Commit blocked - this is the CANONICAL checkout, not a worktree."
        echo "Implementation belongs in a claimed worktree at worktrees/<branch>/."
        echo ""
        echo "Fix:"
        echo "  git worktree add worktrees/<name> -b <name>"
        echo "  cd worktrees/<name>   # re-stage and commit there"
        echo "Prefer the repository's own worktree entry point when it has one,"
        echo "since that also registers the coordination claim."
        echo ""
        echo "Escape hatch (reversible single-writer maintenance only):"
        echo "  ALLOW_CANONICAL_CHECKOUT_COMMIT=1 git commit ..."
        echo ""
        exit 1
    fi
fi
# --- end canonical-checkout guard ---------------------------------------------

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

# Helper: find a script at either scripts/meta/ or scripts/
find_script() {
    local name="$1"
    if [[ -f "$REPO_ROOT/scripts/meta/$name" ]]; then
        echo "$REPO_ROOT/scripts/meta/$name"
    elif [[ -f "$REPO_ROOT/scripts/$name" ]]; then
        echo "$REPO_ROOT/scripts/$name"
    fi
}

# 1. Plan index regeneration (if generator exists)
GENERATOR=$(find_script "generate_plan_index.py")
if [[ -n "$GENERATOR" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Regenerating plan index..."
        python "$GENERATOR" 2>/dev/null || true
        git add docs/plans/CLAUDE.md 2>/dev/null || true
    fi
fi

# 2. Doc-coupling check (if script exists)
DOC_COUPLING=$(find_script "check_doc_coupling.py")
if [[ -n "$DOC_COUPLING" ]]; then
    echo "Checking doc-code coupling..."
    if ! python "$DOC_COUPLING" --strict 2>/dev/null; then
        echo ""
        echo "ERROR: Doc-coupling violation detected!"
        echo "Run 'python $DOC_COUPLING --suggest' to see which docs to update."
        echo ""
        exit 1
    fi
fi

# 3. Mypy on changed src/ files (if mypy is installed)
STAGED_SRC=$(echo "$STAGED_PY" | grep '^src/' || true)
if [[ -n "$STAGED_SRC" ]] && command -v mypy >/dev/null 2>&1; then
    echo "Running mypy on changed files..."
    if ! python -m mypy --strict --ignore-missing-imports --follow-imports=silent $STAGED_SRC 2>/dev/null; then
        echo ""
        echo "ERROR: mypy type check failed!"
        echo ""
        exit 1
    fi
fi

# 4. Plan status consistency (if script exists and plan files staged)
SYNC_STATUS=$(find_script "sync_plan_status.py")
if [[ -n "$SYNC_STATUS" ]]; then
    STAGED_PLANS=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/plans/' || true)
    if [[ -n "$STAGED_PLANS" ]]; then
        echo "Checking plan status consistency..."
        if ! python "$SYNC_STATUS" --check 2>/dev/null; then
            echo ""
            echo "ERROR: Plan status inconsistency detected!"
            echo "Run 'python $SYNC_STATUS --check' to see details"
            echo ""
            exit 1
        fi
    fi
fi

# 5. Dead code check (if enabled in meta-process.yaml)
DEAD_CODE=$(find_script "check_dead_code.py")
if [[ -n "$DEAD_CODE" ]] && [[ -n "$STAGED_PY" ]]; then
    echo "Checking for dead code..."
    if ! python "$DEAD_CODE" 2>/dev/null; then
        echo ""
        echo "ERROR: Dead code check failed!"
        echo "Run 'python $DEAD_CODE' to see details."
        echo ""
        exit 1
    fi
fi

# 6. Branch divergence check
echo "Checking branch freshness..."
git fetch origin 2>/dev/null || true

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || true
REMOTE="origin/$BRANCH"

if git rev-parse --verify "$REMOTE" >/dev/null 2>&1; then
    LOCAL_ONLY=$(git rev-list "$REMOTE..HEAD" --count 2>/dev/null || echo "0")
    REMOTE_ONLY=$(git rev-list "HEAD..$REMOTE" --count 2>/dev/null || echo "0")

    if [ "$REMOTE_ONLY" -gt 0 ] && [ "$LOCAL_ONLY" -gt 0 ]; then
        echo ""
        echo "ERROR: Branch has diverged from remote!"
        echo "  Local commits not on remote: $LOCAL_ONLY"
        echo "  Remote commits not local: $REMOTE_ONLY"
        echo ""
        # `git pull --rebase` refuses outright when the index has staged changes, which
        # is always true here: this is a pre-commit hook, so the caller is mid-commit
        # with a populated index. Printing the bare rebase left the caller deadlocked --
        # the hook demanding a rebase, the rebase demanding a clean index -- and the
        # only escape on offer, --no-verify, lands the unrebased commit this check
        # exists to prevent. Prescribe the sequence that can actually run.
        if git diff --cached --quiet; then
            echo "Resolution:"
            echo "  git pull --rebase origin $BRANCH"
        else
            echo "Resolution (your index has staged changes, so rebase must be"
            echo "unblocked first -- a bare 'git pull --rebase' will refuse):"
            echo "  git stash push -m pre-commit-rebase"
            echo "  git pull --rebase origin $BRANCH"
            echo "  git stash pop --index    # --index preserves what you had staged"
            echo "  # then re-run your commit"
        fi
        echo ""
        echo "Bypass with: git commit --no-verify"
        echo "  This does NOT resolve the divergence -- it commits on top of a stale"
        echo "  base and pushes the conflict downstream. Prefer the resolution above."
        exit 1
    fi

    if [ "$REMOTE_ONLY" -gt 5 ]; then
        echo "WARNING: Branch is $REMOTE_ONLY commits behind remote"
        echo "Consider: git pull --rebase origin $BRANCH"
    fi
fi

echo "Pre-commit checks passed!"
